// ABOUTME: All-in-One Generator for RxDB schemas and mock data aggregation
// ABOUTME: Generates comprehensive schemas and aggregates mock data from all modules

const fs = require('fs');
const path = require('path');
const glob = require('glob');

// Output file paths
const schemaOutputFilePath = path.resolve(__dirname, '../src/core/gn-rxdb-schemas.ts');
const mockDataOutputFilePath = path.resolve(__dirname, '../src/gn-globalMockData.ts');

class MockDataGenerator {
    constructor() {
        this.aggregatedData = {};
        this.EXPORT_KEY_MAP = {
            // Administration module
            'users': 'initialMockUsers',
            'roles': 'initialMockRoles', 
            'students': 'initialMockStudents',
            'staff': 'initialMockStaff',
            'classes': 'initialMockClasses',
            'classStreams': 'initialMockClassStreams',
            'schoolDetails': 'initialMockSchoolDetails',
            'departments': 'initialMockDepartments',
            'designations': 'initialMockDesignations',
            'studentCategories': 'initialMockStudentCategories',
            'dormitories': 'initialMockDormitories',
            'academicYears': 'initialMockAcademicYears',
            'schoolPeriods': 'initialMockSchoolPeriods',
            'academicYearStructures': 'initialMockAcademicYearStructures',
            'academicPeriodDefinitions': 'initialMockAcademicPeriodDefinitions',
            'financialYears': 'initialMockFinancialYears',
            'partners': 'initialMockPartners',
            'clubs': 'initialMockClubs',
            'customers': 'initialMockCustomers',
            'studentHealthRecords': 'initialMockStudentHealthRecords',
            'studentAttendance': 'initialMockStudentAttendance',
            'templatesComm': 'initialMockTemplatesComm',
            'campaigns': 'initialMockCampaigns',
            
            // Academics module
            'subjects': 'initialMockSubjects',
            'subjectPapers': 'initialMockSubjectPapers',
            'examSessions': 'initialMockExamSessions',
            'examPaperSettings': 'initialMockExamPaperSettings',
            'gradingSchemes': 'initialMockGradingSchemes',
            'gradingSchemeLevels': 'initialMockGradingSchemeLevels',
            'studentExamResults': 'initialMockStudentExamResults',
            'studentPaperMarks': 'initialMockStudentPaperMarks',
            'studentSubjectEnrollments': 'initialMockStudentSubjectEnrollments',
            'teacherSubjectAssignments': 'initialMockTeacherSubjectAssignments',
            'timetablePeriodDefs': 'initialMockTimetablePeriodDefs',
            'timetableEntries': 'initialMockTimetableEntries',
            'classSubjectAllocations': 'initialMockClassSubjectAllocations',
            
            // Finance module
            'feeTemplates': 'initialMockFeeTemplates',
            'feeCategories': 'initialMockFeeCategories',
            'feeCollections': 'initialMockFeeCollections',
            'feePayments': 'initialMockFeePayments',
            'chartOfAccounts': 'initialMockChartOfAccounts',
            'banks': 'initialMockBanks',
            'customerInvoices': 'initialMockCustomerInvoices',
            'supplierInvoices': 'initialMockSupplierInvoices',
            'expenses': 'initialMockExpenses',
            'transportRoutes': 'initialMockTransportRoutes',
            'transportStudentAssignments': 'initialMockTransportStudentAssignments',
            'transportFeeCollections': 'initialMockTransportFeeCollections',
            'transportFeePayments': 'initialMockTransportFeePayments',
            'suppliers': 'initialMockSuppliers',
            'purchaseOrders': 'initialMockPurchaseOrders',
            'purchaseOrderItems': 'initialMockPurchaseOrderItems',
            'stockRequisitions': 'initialMockStockRequisitions',
            'stockIssuances': 'initialMockStockIssuances',
            'stockAdjustments': 'initialMockStockAdjustments',
            'stockMovements': 'initialMockStockMovements',
            'stockLevels': 'initialMockStockLevels',
            
            // HR module
            'payrollPeriods': 'initialMockPayrollPeriods',
            'payrollItemTypes': 'initialMockPayrollItemTypes',
            'payrollItems': 'initialMockPayrollItems',
            'payrollPayslips': 'initialMockPayrollPayslips',
            
            // Inventory module
            'warehouses': 'initialMockWarehouses',
            'itemCategories': 'initialMockItemCategories',
            'items': 'initialMockItems',
            'fixedAssets': 'initialMockFixedAssets',
            'stockRequisitions': 'initialMockStockRequisitions',
            'stockIssuances': 'initialMockStockIssuances',
            'stockAdjustments': 'initialMockStockAdjustments',
            'stockMovements': 'initialMockStockMovements',
            'stockLevels': 'initialMockStockLevels',
            
            // Library module
            'bookCategories': 'initialMockBookCategories',
            'books': 'initialMockBooks',
            'bookLoans': 'initialMockBookLoans',
            'bookReturns': 'initialMockBookReturns',
            'bookFines': 'initialMockBookFines',
            
            // Nutrition module
            'mealPlans': 'initialMockMealPlans',
            'menus': 'initialMockMenus',
            'mealConsumptionLogs': 'initialMockMealConsumptionLogs',
            'studentWallets': 'initialMockStudentWallets',
            'walletTransactions': 'initialMockWalletTransactions',
            
            // Settings module
            'auditLogs': 'initialMockAuditLogs',
            'systemSettings': 'initialMockSystemSettings',
            'userPermissions': 'initialMockUserPermissions',
            'workflowSettings': 'initialMockWorkflowSettings',
            'databaseSettings': 'initialMockDatabaseSettings'
        };
    }

    async aggregateModularMockData() {
        console.log('  -> Aggregating all module mockData.ts files by AppDataType key (with mapping)...');
        
        // Use a more reliable glob pattern for Windows
        const mockDataFiles = glob.sync('src/modules/*/data/mockData.ts', { 
            cwd: path.resolve(__dirname, '..'),
            absolute: true 
        });
        
        console.log(`[GENERATOR] Found ${mockDataFiles.length} mockData.ts files to process`);
        console.log(`[GENERATOR] Files found:`, mockDataFiles);
        
        const APP_DATA_KEYS = [
            'schoolDetails', 'roles', 'users', 'students', 'staff', 'classes', 'classStreams', 'subjects', 'departments', 'designations', 'studentCategories', 'dormitories', 'academicYears', 'schoolPeriods', 'academicYearStructures', 'academicPeriodDefinitions', 'financialYears', 'partners', 'clubs', 'customers', 'studentHealthRecords', 'studentAttendance', 'timetablePeriodDefs', 'templatesComm', 'campaigns', 'subjectPapers', 'examSessions', 'examPaperSettings', 'gradingSchemes', 'gradingSchemeLevels', 'studentExamResults', 'studentPaperMarks', 'studentSubjectEnrollments', 'teacherSubjectAssignments', 'timetableEntries', 'classSubjectAllocations', 'feeTemplates', 'feeCategories', 'feeCollections', 'feePayments', 'chartOfAccounts', 'banks', 'customerInvoices', 'supplierInvoices', 'expenses', 'transportRoutes', 'transportStudentAssignments', 'transportFeeCollections', 'transportFeePayments', 'suppliers', 'purchaseOrders', 'purchaseOrderItems', 'stockRequisitions', 'stockIssuances', 'stockAdjustments', 'stockMovements', 'stockLevels', 'payrollPeriods', 'payrollItemTypes', 'payrollItems', 'payrollPayslips', 'warehouses', 'itemCategories', 'items', 'fixedAssets', 'bookCategories', 'books', 'bookLoans', 'bookReturns', 'bookFines', 'mealPlans', 'menus', 'mealConsumptionLogs', 'studentWallets', 'walletTransactions', 'auditLogs', 'systemSettings', 'userPermissions', 'workflowSettings', 'databaseSettings'
        ];

        for (const key of APP_DATA_KEYS) {
            console.log(`[GENERATOR] Processing key: ${key}`);
            this.aggregatedData[key] = [];
            
            for (const file of mockDataFiles) {
                try {
                    console.log(`[GENERATOR]   Attempting to import: ${file}`);
                    
                    // Convert Windows path to proper file:// URL for ESM imports
                    const fileUrl = `file:///${file.replace(/\\/g, '/').replace(/^([A-Za-z]):/, '$1')}`;
                    const mod = await import(fileUrl);
                    console.log(`[GENERATOR]   Successfully imported: ${file}`);
                    
                    // Get the mapped export name
                    const exportName = this.EXPORT_KEY_MAP[key];
                    if (exportName && mod[exportName]) {
                        console.log(`[GENERATOR]     Found ${exportName} with ${mod[exportName].length} items`);
                        this.aggregatedData[key].push(...mod[exportName]);
                    } else {
                        console.log(`[GENERATOR]     No ${exportName} found in ${file}`);
                    }
                } catch (e) {
                    console.warn(`[GENERATOR] Could not import file: ${file}`, e);
                    continue;
                }
            }
            
            console.log(`[GENERATOR] Total items for ${key}: ${this.aggregatedData[key].length}`);
        }
    }

    generateMockDataFile() {
        console.log('  -> Generating aggregated mock data file...');
        
        const mockDataContent = `// ABOUTME: Aggregated mock data from all modules
// ABOUTME: Generated by gn-generate-all.cjs - DO NOT EDIT MANUALLY

import { faker } from '@faker-js/faker';

// Aggregated mock data from all modules
export const globalMockData = {
${Object.entries(this.aggregatedData).map(([key, data]) => {
    if (data.length === 0) {
        return `  ${key}: [],`;
    }
    return `  ${key}: ${JSON.stringify(data, null, 2).split('\n').map(line => '    ' + line).join('\n')},`;
}).join('\n')}
};

// Export individual collections for direct access
${Object.entries(this.aggregatedData).map(([key, data]) => {
    if (data.length === 0) {
        return `export const ${key} = [];`;
    }
    return `export const ${key} = globalMockData.${key};`;
}).join('\n')}

// Helper function to get all mock data
export const getAllMockData = () => globalMockData;

// Helper function to get specific collection
export const getMockData = (collectionName) => globalMockData[collectionName] || [];

// Helper function to add mock data
export const addMockData = (collectionName, data) => {
  if (!globalMockData[collectionName]) {
    globalMockData[collectionName] = [];
  }
  globalMockData[collectionName].push(data);
};

// Helper function to clear mock data
export const clearMockData = (collectionName) => {
  globalMockData[collectionName] = [];
};
`;

        fs.writeFileSync(mockDataOutputFilePath, mockDataContent);
        console.log(`  -> Generated: ${mockDataOutputFilePath}`);
    }

    async generate() {
        console.log('🚀 Starting Mock Data Generator...');
        
        await this.aggregateModularMockData();
        this.generateMockDataFile();
        
        console.log('✅ Mock Data Generation Complete!');
        console.log(`📊 Generated ${Object.keys(this.aggregatedData).length} collections`);
        console.log(`📁 Output: ${mockDataOutputFilePath}`);
    }
}

// Run the generator
const generator = new MockDataGenerator();
generator.generate().catch(console.error); 