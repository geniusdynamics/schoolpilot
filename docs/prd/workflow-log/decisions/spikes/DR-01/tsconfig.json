{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node", "vite/client"],
    "baseUrl": "../../../../../..",
    "paths": { "@/*": ["src/*"] }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "bundle/*.js"]
}
