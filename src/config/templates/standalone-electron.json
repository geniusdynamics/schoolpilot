{
  "_version": "2.1.0",
  "_template": "standalone-electron",
  "_description": "Electron desktop application with local SQLite File storage, no sync",

  "deployment": {
    "scenario": "standalone",
    "environment": "electron"
  },

  "provider": {
    "type": "sqlite-file",
    "fallbackChain": ["pouchdb", "memory"]
  },

  "sqlite": {
    "filename": "schoolpilot.db",
    "vfs": "file",
    "wal": true,
    "encryption": {
      "enabled": false
    }
  },

  "general": {
    "autoInit": true,
    "retryOnFailure": true,
    "maxRetries": 3,
    "logLevel": "info"
  },

  "performance": {
    "enableIndexing": true,
    "enableCaching": true,
    "cacheSize": 100,
    "queryTimeout": 30000,
    "batchSize": 500
  },

  "storage": {
    "compressionEnabled": true,
    "encryptionEnabled": false,
    "backupEnabled": true,
    "retentionDays": 90
  },

  "sync": {
    "enabled": false
  },

  "monitoring": {
    "enableHealthChecks": true,
    "healthCheckInterval": 300000,
    "enablePerformanceMetrics": true,
    "enableErrorReporting": true,
    "logLevel": "info"
  },

  "features": {
    "enableFullTextSearch": true,
    "enableTransactions": true,
    "enableRealTimeUpdates": true,
    "enableOfflineMode": true,
    "enableDataValidation": true,
    "enableAuditLog": true
  }
}
