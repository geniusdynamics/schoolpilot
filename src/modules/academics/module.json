{
  "$schema": "../../schemas/module-schema.json",
  "id": "academics",
  "name": "Academics",
  "version": "1.0.0",
  "description": "Academic management including subjects, exams, grading, timetables, and results",
  "author": {
    "name": "SchoolPilot Team",
    "url": "https://schoolpilot.io"
  },
  "license": "MIT",
  "keywords": ["academics", "subjects", "exams", "grading", "timetable", "results"],
  "dependencies": [
    {
      "moduleId": "administration",
      "version": "^1.0.0",
      "required": true,
      "reason": "Requires students, staff, and classes for academic records",
      "imports": ["students", "staff", "classes", "academicYears"]
    }
  ],
  "optionalDependencies": [],
  "conflicts": [],
  "schemas": [
    "subjects",
    "subject_papers",
    "exam_sessions",
    "exam_schedules",
    "exam_paper_settings",
    "grading_schemes",
    "grading_scheme_levels",
    "student_exam_results",
    "student_paper_marks",
    "result_approvals",
    "class_subject_allocations",
    "teacher_subject_assignments",
    "student_subject_enrollments",
    "timetable_period_definitions",
    "timetable_entries"
  ],
  "migrations": "./migrations",
  "provides": {
    "entities": [
      "subjects",
      "exams",
      "grades",
      "timetables",
      "results"
    ],
    "services": [
      "ExamService",
      "GradingService",
      "TimetableService",
      "ResultService"
    ],
    "hooks": [
      "onExamScheduled",
      "onResultsPublished",
      "onGradeCalculated"
    ],
    "routes": [
      "/academics/*"
    ]
  },
  "capabilities": {
    "offlineSupport": true,
    "requiresBackend": false,
    "multiTenant": false,
    "supportsSync": true,
    "realTime": false
  },
  "config": {
    "enableExamScheduling": true,
    "enableGradingSchemes": true,
    "enableTimetable": true,
    "enableSubjectAllocation": true,
    "enableOnlineResults": true,
    "defaultGradingScheme": "percentage",
    "allowMultipleGradingSchemes": true,
    "resultApprovalRequired": true
  },
  "minSchoolPilotVersion": "1.0.0",
  "targetSchoolPilotVersion": "1.0.0"
}
