# Database Configuration for Migration Scripts

# Akademico Database (Source) - PostgreSQL
AKADEMICO_HOST=localhost
AKADEMICO_PORT=5432
AKADEMICO_USER=postgres
AKADEMICO_PASSWORD=your_password_here
AKADEMICO_DB=akademico

# SchoolPilot Database (Target) - MySQL
SCHOOLPILOT_HOST=localhost
SCHOOLPILOT_PORT=3306
SCHOOLPILOT_USER=root
SCHOOLPILOT_PASSWORD=your_password_here
SCHOOLPILOT_DB=schoolpilot

# Migration Settings
MIGRATION_CHUNK_SIZE=1000
MIGRATION_MAX_RETRIES=3
MIGRATION_LOG_LEVEL=info

# RxDB Settings
RXDB_DB_NAME=schoolpilot3
RXDB_LEADER_ELECTION_DISABLED=false

# API Keys
GEMINI_API_KEY=placeholder_api_key

# Frontend-only mode - disable backend detection
REACT_APP_API_URL=

