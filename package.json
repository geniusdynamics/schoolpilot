    "setup:self-hosted:linux": "node scripts/setup-self-hosted.cjs && echo '📋 Now configure your firewall and start the server'",
    "setup:self-hosted:windows": "node scripts/setup-self-hosted.cjs && echo '📋 Now configure Windows Firewall and start the server'",
    "seed:validate": "tsx scripts/seed-validate.ts",
    "check:ratchet": "node scripts/check-type-ratchet.cjs",
    "secret:scan": "node scripts/prd/secret-scan.mjs"
