          {
            "code": "AE1",
            "label": "Approaching Expectations 1",
            "min": 31,
            "max": 40,
            "points": 4
          },
          {
            "code": "AE2",
            "label": "Approaching Expectations 2",
            "min": 21,
            "max": 30,
            "points": 3
          },
          {
            "code": "BE1",
            "label": "Below Expectations 1",
            "min": 11,
            "max": 20,
            "points": 2
          },
          {
            "code": "BE2",
            "label": "Below Expectations 2",
            "min": 1,
            "max": 10,
            "points": 1
          }
        ],
        "verification": "Bands as commonly published for Junior School/KJSEA reporting; confirm against the current KNEC circular."
      },
      {
        "code": "cbe_4_level",
        "kind": "rubric",
        "upper": "inclusive",
        "bands": [
          {
            "code": "EE",
            "label": "Exceeding Expectations",
            "min": 4,
            "max": 4,
            "points": 4
          },
          {
            "code": "ME",
            "label": "Meeting Expectations",
            "min": 3,
            "max": 3,
            "points": 3
          },
          {
            "code": "AE",
            "label": "Approaching Expectations",
            "min": 2,
            "max": 2,
            "points": 2
          },
          {
            "code": "BE",
            "label": "Below Expectations",
            "min": 1,
            "max": 1,
            "points": 1
          }
        ],
        "verification": "Rubric levels from the CBE primary reporting guidance; the 4-to-1 level values are illustrative."
      }
    ],
    "aggregations": [
      {
        "code": "cbe_mean_percent",
        "op": "mean",
        "value": "score",
        "precision": 1,
        "result_scale": "cbe_8_level"
      }
    ],
    "ranking": {
      "enabled": false,
      "scope": "class_group",
      "by": "cbe_mean_percent",
      "ties": "competition_1224",
      "only_complete": true,
      "show_on_report": false,
      "show_out_of": true
