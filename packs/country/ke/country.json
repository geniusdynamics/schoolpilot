      "hintKey": "country.ke.identifier.birth_certificate.hint",
      "example": "as printed on the certificate",
      "verification": "draft",
      "note": "Birth certificate numbers have no published format the pack cites; they are kept as written."
    },
    {
      "scheme": "ke.national_id",
      "labelKey": "country.ke.identifier.national_id",
      "appliesTo": ["learner", "guardian", "staff"],
      "order": { "learner": 3, "guardian": 1, "staff": 1 },
      "validation": { "type": "pattern", "pattern": "^[0-9]{7,8}$", "normalise": ["trim", "remove_spaces"] },
      "hintKey": "country.ke.identifier.national_id.hint",
      "example": "12345678",
      "verification": "draft",
      "note": "Seven or eight digits is a lenient working rule, not a published format; no official source is cited."
    },
    {
      "scheme": "ke.kra_pin",
      "labelKey": "country.ke.identifier.kra_pin",
      "appliesTo": ["staff"],
      "order": { "staff": 2 },
      "validation": { "type": "pattern", "pattern": "^[AP][0-9]{9}[A-Z]$", "normalise": ["trim", "remove_spaces", "uppercase"] },
      "hintKey": "country.ke.identifier.kra_pin.hint",
      "example": "A000000000X",
      "sourceRef": "kra-pin-format",
      "verification": "verified",
      "note": "Format only: a well-formed PIN is not proof that KRA issued it."
    },
