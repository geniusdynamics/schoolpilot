      "hintKey": "country.ke.identifier.kemis_upi.hint",
      "example": "as printed on the KEMIS record",
      "verification": "draft",
      "note": "The KEMIS Unique Personal Identifier has no published format the pack cites; it is kept as written."
    },
    {
      "scheme": "ke.birth_certificate",
