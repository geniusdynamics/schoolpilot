  "identifiers": [
    {
      "scheme": "rw.nid",
      "labelKey": "country.rw.identifier.nid",
      "appliesTo": ["learner", "guardian", "staff"],
      "order": { "learner": 1, "guardian": 1, "staff": 1 },
      "validation": { "type": "pattern", "pattern": "^[0-9]{16}$", "normalise": ["trim", "remove_spaces", "remove_hyphens"] },
      "hintKey": "country.rw.identifier.nid.hint",
      "example": "1199080012345678",
      "sourceRef": "id4d-rwanda",
      "verification": "draft",
      "note": "Format only: sixteen digits. The last two are a check the issuer keeps secret, so the pack cannot verify them. A well-formed number is not proof that NIDA issued it."
    },
    {
      "scheme": "rw.birth_certificate",
      "labelKey": "country.rw.identifier.birth_certificate",
      "appliesTo": ["learner"],
      "order": { "learner": 2 },
      "validation": { "type": "free" },
      "hintKey": "country.rw.identifier.birth_certificate.hint",
      "example": "as printed on the certificate",
      "verification": "draft",
      "note": "No published format the pack cites."
    },
    {
      "scheme": "rw.tin",
