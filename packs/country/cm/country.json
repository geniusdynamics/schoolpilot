      "accessed": "2026-10-27"
    },
    {
      "id": "dgi-calendrier-fiscal",
      "title": "Calendrier fiscal (monthly deposits within the first 15 days; VS/IRPP + IS + TVA monthly declaration and payment 15 days after the month, road-transporter table)",
      "publisher": "Direction Generale des Impots, Cameroon",
      "url": "https://www.impots.cm/fr/calendrier-fiscal",
      "accessed": "2026-10-27"
    }
  ],
