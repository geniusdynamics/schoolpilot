        { "code": "7", "label": "7", "min": 3, "max": 3, "points": 3 },
        { "code": "8", "label": "8", "min": 2, "max": 2, "points": 2 },
        { "code": "9", "label": "9", "min": 1, "max": 1, "points": 1 }
