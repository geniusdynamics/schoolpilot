        { "code": "2", "label": "2", "min": 8, "max": 8, "points": 8 },
        { "code": "3", "label": "3", "min": 7, "max": 7, "points": 7 },
        { "code": "4", "label": "4", "min": 6, "max": 6, "points": 6 },
        { "code": "5", "label": "5", "min": 5, "max": 5, "points": 5 },
