  "grading_scales": [
    {
      "code": "eyfs_emerging_expected",
      "kind": "rubric",
      "input": "rubric_level",
      "upper": "inclusive",
      "bands": [
        {
          "code": "EX",
          "label": "Expected",
          "min": 2,
          "max": 2,
          "points": 2,
          "descriptor": "The child meets the Early Learning Goal."
        },
        {
          "code": "EM",
          "label": "Emerging",
          "min": 1,
          "max": 1,
          "points": 1,
          "descriptor": "The child is still working towards the Early Learning Goal."
        }
      ],
      "verification": "Two-level judgement from the EYFS statutory framework: at the end of Reception each Early Learning Goal is recorded as met (Expected) or not yet met (Emerging). This is a teacher judgement against the ELG descriptors, not a percentage cut-off."
    },
    {
      "code": "attainment_4_level",
      "kind": "rubric",
      "input": "rubric_level",
      "upper": "inclusive",
      "bands": [
        {
          "code": "GD",
          "label": "Greater depth",
          "min": 4,
          "max": 4,
          "points": 4,
          "descriptor": "Applies the knowledge securely and explains it in unfamiliar contexts."
        },
        {
          "code": "EX",
          "label": "Expected",
          "min": 3,
          "max": 3,
          "points": 3,
          "descriptor": "Meets the age-related expectation for the year group."
        },
        {
          "code": "WT",
          "label": "Working towards",
          "min": 2,
          "max": 2,
          "points": 2,
          "descriptor": "Working towards the age-related expectation and needs support to close the gap."
        },
        {
          "code": "BE",
          "label": "Below expectation",
          "min": 1,
          "max": 1,
          "points": 1,
          "descriptor": "Working well below the age-related expectation and needs a modified curriculum."
        }
      ],
      "verification": "Four-level attainment judgement (greater depth, expected, working towards, below) as used for primary and key stage 3 reports against age-related expectations. The DfE abolished statutory levels in 2015 and does not prescribe a replacement scale, so this is the school's reporting rubric, declared here so it can be reported and overridden consistently. It is not a national cut-off."
    },
    {
      "code": "gcse_9_1",
