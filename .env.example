# Database Configuration for Migration Scripts

# Akademico Database (Source) - PostgreSQL
AKADEMICO_HOST=localhost
AKADEMICO_PORT=5432
AKADEMICO_USER=postgres
AKADEMICO_PASSWORD=your_password_here
AKADEMICO_DB=akademico

# SchoolPilot Database (Target) - MySQL
SCHOOLPILOT_HOST=localhost
SCHOOLPILOT_PORT=3306
SCHOOLPILOT_USER=root
SCHOOLPILOT_PASSWORD=your_password_here
SCHOOLPILOT_DB=schoolpilot

# Migration Settings
MIGRATION_CHUNK_SIZE=1000
MIGRATION_MAX_RETRIES=3
MIGRATION_LOG_LEVEL=info

# RxDB Settings
RXDB_DB_NAME=schoolpilot3
RXDB_LEADER_ELECTION_DISABLED=false

# Error Tracking (Bugsink)
VITE_BUGSINK_DSN=https://your_bugsink_dsn_here

# ============================================
# Self-Hosting Deployment Configuration
# ============================================
# These settings configure the application for self-hosted deployment
# on local networks without requiring CouchDB synchronization.

# Server Network Settings
# Port for the development server (default: 5200)
VITE_PORT=5200
# Host address - use 0.0.0.0 for network access, localhost for local only
VITE_HOST=0.0.0.0
# Whether to fail if port is already in use (default: false)
VITE_STRICT_PORT=false

# Database Configuration
# Database provider: sqlite-wasm (recommended), livestore, pouchdb, backend-api
VITE_DB_PROVIDER=sqlite-wasm
# Database mode: production (real data) or demo (sample data)
VITE_DB_MODE=production
# Deployment environment: development, staging, production
VITE_DEPLOYMENT_ENV=production

# SQLite WASM + OPFS Settings
# Enable WAL mode for better concurrent read performance
VITE_SQLITE_WAL_MODE=true
# Enable foreign key constraints
VITE_SQLITE_FOREIGN_KEYS=true
# Cache size in KB (default: 20000 = 20MB)
VITE_SQLITE_CACHE_SIZE=20000
# Synchronous mode: 0=OFF, 1=NORMAL, 2=FULL (recommended: 1 for performance)
VITE_SQLITE_SYNCHRONOUS=1

# LiveStore Settings (Alternative to SQLite)
# Enable LiveStore for real-time reactive updates
VITE_LIVESTORE_ENABLED=false
# LiveStore adapter: opfs (default), memory, indexeddb
VITE_LIVESTORE_ADAPTER=opfs

# Cloud Backend Integration (Optional)
# Backend API URL for cloud features (leave empty for offline-only)
VITE_BACKEND_API_URL=
# Backend API key (if required)
VITE_BACKEND_API_KEY=

# ERPNext Integration (Optional)
# ERPNext instance URL
VITE_ERPNEXT_URL=
# ERPNext API key
VITE_ERPNEXT_API_KEY=
# ERPNext API secret
VITE_ERPNEXT_API_SECRET=

# Security Settings
# Enable HTTPS in production (requires SSL certificate)
VITE_ENABLE_HTTPS=false
# Session timeout in minutes (default: 60)
VITE_SESSION_TIMEOUT=60
# Enable audit logging
VITE_ENABLE_AUDIT_LOG=true

# Performance Settings
# Enable query caching (default: true)
VITE_ENABLE_QUERY_CACHE=true
# Query cache TTL in seconds (default: 300 = 5 minutes)
VITE_QUERY_CACHE_TTL=300
# Maximum concurrent connections (SQLite recommended: 10)
VITE_MAX_CONCURRENT_CONNECTIONS=10

# ============================================
# Module Independence Feature Flags
# ============================================
# These flags enable gradual rollout of modularity improvements.
# All flags default to false (backward compatible behavior).

# Enable useSharedData hook for cross-module data access
# When true: modules use useSharedData() hook instead of direct imports
VITE_USE_SHARED_DATA_HOOK=false

# Enable module.json metadata system
# When true: module metadata loaded from module.json files
VITE_USE_MODULE_METADATA=false

# Enable schema auto-registration
# When true: schemas auto-discovered from module files
VITE_USE_SCHEMA_AUTO_REGISTRATION=false

# Enable module migration system
# When true: module migrations run on startup
VITE_USE_MODULE_MIGRATIONS=false

# Enable strict module isolation
# When true: cross-module imports throw errors
VITE_STRICT_MODULE_ISOLATION=false

# Enable deprecation warnings
# When true: console warnings shown for legacy patterns
VITE_ENABLE_DEPRECATION_WARNINGS=true
