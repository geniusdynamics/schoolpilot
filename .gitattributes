# ABOUTME: Line endings the container needs: a shell script or Dockerfile stored with CRLF fails on
# ABOUTME: Linux (a shebang ending in \r is a bad interpreter). Only the files that must be LF are pinned.

*.sh text eol=lf
Dockerfile text eol=lf
*.conf text eol=lf
docker-compose*.yml text eol=lf
.github/workflows/*.yml text eol=lf
