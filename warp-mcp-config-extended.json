{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "your_github_token_here",
        "GITHUB_API_URL": "https://api.github.com"
      }
    },
    "github-enterprise": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "your_enterprise_token_here",
        "GITHUB_API_URL": "https://your-enterprise.github.com/api/v3"
      }
    }
  },
  "tools": {
    "github": {
      "repositories": [
        "owner/repo1",
        "owner/repo2"
      ],
      "permissions": [
        "read",
        "write"
      ]
    }
  }
}
